{
  "name": "whats-in-the-fridge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,app -c green,blue \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "NODE_ENV=development node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "refresh:grocery": "node tasks/refreshGroceryData.js",
    "refresh:grocery:sneak": "node tasks/refreshGroceryData.js --mode sneakPeek",
    "refresh:grocery:reset": "node tasks/refreshGroceryData.js --mode officialReset",
    "seed:weekly-deals": "node tasks/seedWeeklyDeals.js",
    "seed:recipes": "node server/scripts/seedRecipes.js"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.460.0",
    "mongodb": "^6.21.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^4.5.5"
  }
}
