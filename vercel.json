{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/sneak-peek",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/official-reset",
      "schedule": "1 13 * * 2"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/cron/sneak-peek.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/cron/official-reset.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/cron/refresh-grocery-data.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  }
}
