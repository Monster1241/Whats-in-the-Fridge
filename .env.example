# MongoDB Atlas connection string (required locally and on Vercel)
MONGODB_URI=mongodb+srv://fridgeuser:yourpassword@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=your-long-random-secret

# Local dev only — API port when running npm run dev:server (default 3001)
PORT=3001

# Optional — comma-separated allowed browser origins (production domain)
# CORS_ORIGIN=https://your-app.vercel.app

# Optional — only if your API runs on a different host. Leave unset on Vercel.
# VITE_API_URL=https://your-app.vercel.app/api
