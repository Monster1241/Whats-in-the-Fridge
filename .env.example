# Copy to .env for local dev (never commit .env)

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-secret-at-least-32-characters

# Resend — https://resend.com (optional locally; required for real verification emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Free tier: use onboarding@resend.dev or your verified domain
RESEND_FROM_EMAIL=What's in the Fridge <onboarding@resend.dev>

PORT=3001

# Local development — npm run dev sets NODE_ENV=development (disables Express rate limits)
# DISABLE_RATE_LIMIT=true

# Grocery data refresh (Vercel Cron + optional local scheduler)
# CRON_SECRET=long-random-secret-for-vercel-cron-auth
# ENABLE_GROCERY_CRON=1

# Firebase (client — optional overrides; defaults in src/firebase/config.js)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Web Push — Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# VITE_FIREBASE_VAPID_KEY=

# Firebase Admin — paste full service account JSON (one line) for /api/auth/session
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini AI recipe matching (server-only — never expose to the client)
# Uses gemini-2.0-flash (see server/controllers/aiRecipe.js)
# GEMINI_API_KEY=
