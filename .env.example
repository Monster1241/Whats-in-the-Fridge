# Copy to .env for local dev (never commit .env)

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-secret-at-least-32-characters

# Resend — https://resend.com (optional locally; required for real verification emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Free tier: use onboarding@resend.dev or your verified domain
RESEND_FROM_EMAIL=What's in the Fridge <onboarding@resend.dev>

PORT=3001

# Firebase (client — optional overrides; defaults in src/firebase.js)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# Firebase Admin — paste full service account JSON (one line) for /api/auth/session
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=
