# MongoDB Atlas connection string (required locally and on Vercel)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Local dev only — API port when running npm run dev:server (default 3001)
PORT=3001

# Optional — only if your API runs on a different host. Leave unset on Vercel.
# VITE_API_URL=https://your-app.vercel.app/api
